    "test:all": "vitest run && playwright test",
    "video": "playwright test -c playwright.video.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/node": "^26.6.2",
    "marked": "^18.0.13",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^13.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
